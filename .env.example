DATABASE_URL=postgresql://expert_engine:expert_engine@127.0.0.1:5433/expert_engine
KNOWLEDGE_BACKEND=postgres
RUN_BACKEND=postgres
HITL_CHECKPOINT_BACKEND=postgres

# Set LLM_ENABLED=true only after configuring an OpenAI-compatible gateway.
# Copy this file to .env; .env is intentionally excluded from version control.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_EVENT_MODEL=
LLM_RESEARCH_MODEL=
LLM_SYNTHESIS_MODEL=
LLM_REVIEW_MODEL=
LLM_NEED_MODEL=
LLM_CANDIDATE_MODEL=
LLM_KNOWLEDGE_MODEL=
PUBLISHED_KNOWLEDGE_RELIABILITY=0.8
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=
RETRIEVAL_LEXICAL_WEIGHT=0.6
RETRIEVAL_VECTOR_WEIGHT=0.4
BM25_ENABLED=false
BM25_BASE_URL=
BM25_INDEX=knowledge
BM25_API_KEY=
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=

# Optional per-responsibility overrides. Unset fields fall back to the global
# LLM_BASE_URL / LLM_API_KEY and the corresponding global model variable.
# Example:
# LLM_EVENT_ANALYZER_BASE_URL=https://event-gateway.example/v1
# LLM_EVENT_ANALYZER_API_KEY=<event-gateway-key>
# LLM_EVENT_ANALYZER_MODEL=<event-model>
# LLM_RESEARCH_PLANNER_BASE_URL=https://research-gateway.example/v1
# LLM_RESEARCH_PLANNER_API_KEY=<research-gateway-key>
# LLM_RESEARCH_PLANNER_MODEL=<research-model>
# The same full Profile-name convention applies to
# OPPORTUNITY_SYNTHESIS, EVIDENCE_CRITIC, NEED_REASONING,
# CANDIDATE_REASONING, KNOWLEDGE_EXTRACTION and EMBEDDING.
LOG_LEVEL=INFO
